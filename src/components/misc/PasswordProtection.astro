---
// src/components/misc/PasswordProtection.astro
// 与 scripts/encrypt-posts.js 配套：前端 AES-GCM 解密
export interface Props {
  ciphertext: string;
  slug: string;
}
const { ciphertext, slug } = Astro.props;
---

<div id={`lock-${slug}`} class="password-gate">
  <h2>🔒 这篇文章受密码保护</h2>
  <input type="password" id={`pwd-${slug}`} placeholder="输入密码解锁" />
  <button id={`btn-${slug}`}>解锁</button>
  <p id={`err-${slug}`} style="color: red; display: none;">密码错误，请重试</p>
</div>
<div id={`content-${slug}`} style="display: none;"></div>

<script is:inline define:vars={{ ciphertext, slug }}>
  const ALGO = 'AES-GCM';
  const ITERATIONS = 100000;
  const SALT_LEN = 16;
  const IV_LEN = 12;

  function base64ToUint8Array(base64) {
    const binary = atob(base64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return bytes;
  }

  async function deriveKey(pwd, salt) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      'raw', enc.encode(pwd), 'PBKDF2', false, ['deriveKey']
    );
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: ITERATIONS, hash: 'SHA-256' },
      keyMaterial,
      { name: ALGO, length: 256 },
      false,
      ['decrypt']
    );
  }

  async function decryptContent(base64Combined, pwd) {
    const combined = base64ToUint8Array(base64Combined);
    const salt = combined.slice(0, SALT_LEN);
    const iv = combined.slice(SALT_LEN, SALT_LEN + IV_LEN);
    const data = combined.slice(SALT_LEN + IV_LEN);

    const key = await deriveKey(pwd, salt);
    const plainBuffer = await crypto.subtle.decrypt({ name: ALGO, iv }, key, data);
    return new TextDecoder().decode(plainBuffer);
  }

  const btn = document.getElementById(`btn-${slug}`);
  const pwdInput = document.getElementById(`pwd-${slug}`);
  const errP = document.getElementById(`err-${slug}`);
  const gate = document.getElementById(`lock-${slug}`);
  const contentDiv = document.getElementById(`content-${slug}`);

  async function tryUnlock() {
    const input = pwdInput.value;
    if (!input) return;

    try {
      const html = await decryptContent(ciphertext, input);
      contentDiv.innerHTML = html;
      contentDiv.style.display = 'block';
      gate.style.display = 'none';
      sessionStorage.setItem(`unlocked-${slug}`, 'true');
    } catch (e) {
      errP.style.display = 'block';
      pwdInput.value = '';
      pwdInput.focus();
    }
  }

  btn.addEventListener('click', tryUnlock);
  pwdInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') tryUnlock();
  });
</script>

<style>
  .password-gate {
    padding: 2rem;
    text-align: center;
    background: var(--card-bg);
    border-radius: 0.75rem;
  }
  .password-gate input {
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
  }
  .password-gate button {
    padding: 0.5rem 1.5rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
  }
</style>
