---
// src/components/misc/PasswordProtection.astro
// 与 scripts/encrypt-posts.js 配套：前端 AES-GCM 解密
import { siteConfig } from "../../config";

export interface Props {
  ciphertext: string;
  slug: string;
}
const { ciphertext, slug } = Astro.props;
---

<div id={`lock-${slug}`} class="password-gate">
  <h2>🔒 这篇文章受密码保护</h2>
  <input type="password" id={`pwd-${slug}`} placeholder="输入密码解锁" />
  <button id={`btn-${slug}`}>解锁</button>
  <p id={`err-${slug}`} style="color: red; display: none;">密码错误，请重试</p>
</div>
<!-- 与 Markdown.astro 保持同一套样式容器，保证解密后排版与普通文章一致 -->
<div
  id={`content-${slug}`}
  class="prose dark:prose-invert prose-base !max-w-none custom-md"
  style="display: none;"
></div>

<script is:inline define:vars={{ ciphertext, slug, tocEnabled: siteConfig.toc.enable, tocDepth: siteConfig.toc.depth }}>
  const ALGO = 'AES-GCM';
  const ITERATIONS = 100000;
  const SALT_LEN = 16;
  const IV_LEN = 12;

  function base64ToUint8Array(base64) {
    const binary = atob(base64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return bytes;
  }

  async function deriveKey(pwd, salt) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      'raw', enc.encode(pwd), 'PBKDF2', false, ['deriveKey']
    );
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: ITERATIONS, hash: 'SHA-256' },
      keyMaterial,
      { name: ALGO, length: 256 },
      false,
      ['decrypt']
    );
  }

  async function decryptContent(base64Combined, pwd) {
    const combined = base64ToUint8Array(base64Combined);
    const salt = combined.slice(0, SALT_LEN);
    const iv = combined.slice(SALT_LEN, SALT_LEN + IV_LEN);
    const data = combined.slice(SALT_LEN + IV_LEN);

    const key = await deriveKey(pwd, salt);
    const plainBuffer = await crypto.subtle.decrypt({ name: ALGO, iv }, key, data);
    return new TextDecoder().decode(plainBuffer);
  }

  // 密文在构建期无法生成目录，解锁后按解密出的标题在客户端补全右侧目录
  function buildToc(contentRoot) {
    if (!tocEnabled) return;
    const tocEl = document.querySelector('#toc table-of-contents');
    if (!tocEl) return;

    const nodes = Array.from(contentRoot.querySelectorAll('h1, h2, h3, h4, h5, h6'))
      .filter((h) => !h.closest('pre, code'));
    if (!nodes.length) return;

    // 移除可能残留的旧条目（保留 active-indicator）
    tocEl.querySelectorAll('a[href^="#"]').forEach((a) => a.remove());

    let minDepth = 10;
    nodes.forEach((h) => {
      minDepth = Math.min(minDepth, Number(h.tagName[1]));
    });

    let num = 1;
    const frag = document.createDocumentFragment();
    nodes.forEach((h, i) => {
      const depth = Number(h.tagName[1]);
      if (depth >= minDepth + tocDepth) return;

      if (!h.id) h.id = `enc-${slug}-${i + 1}`;

      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.className = 'px-2 flex gap-2 relative transition w-full min-h-9 rounded-xl hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2';

      const badge = document.createElement('div');
      let badgeClass = 'transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold';
      if (depth === minDepth) {
        badgeClass += ' bg-[var(--toc-badge-bg)] text-[var(--btn-content)]';
        badge.textContent = String(num++);
      } else if (depth === minDepth + 1) {
        badgeClass += ' ml-4';
        const dot = document.createElement('div');
        dot.className = 'transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]';
        badge.appendChild(dot);
      } else {
        badgeClass += ' ml-8';
        const dot = document.createElement('div');
        dot.className = 'transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10';
        badge.appendChild(dot);
      }
      badge.className = badgeClass;

      const text = document.createElement('div');
      text.className = 'transition text-sm ' +
        (depth <= minDepth + 1 ? 'text-50' : 'text-30');
      text.textContent = (h.textContent || '').trim();

      a.append(badge, text);
      frag.appendChild(a);
    });

    const indicator = tocEl.querySelector('#active-indicator');
    tocEl.insertBefore(frag, indicator);
    indicator?.classList.remove('hidden');

    // 让 TOC 自定义元素重新扫描新条目，恢复滚动高亮
    if (typeof tocEl.init === 'function') tocEl.init();
  }

  const btn = document.getElementById(`btn-${slug}`);
  const pwdInput = document.getElementById(`pwd-${slug}`);
  const errP = document.getElementById(`err-${slug}`);
  const gate = document.getElementById(`lock-${slug}`);
  const contentDiv = document.getElementById(`content-${slug}`);

  async function tryUnlock() {
    const input = pwdInput.value;
    if (!input) return;

    try {
      const html = await decryptContent(ciphertext, input);
      contentDiv.innerHTML = html;
      contentDiv.style.display = 'block';
      gate.style.display = 'none';
      sessionStorage.setItem(`unlocked-${slug}`, 'true');
      buildToc(contentDiv);
    } catch (e) {
      errP.style.display = 'block';
      pwdInput.value = '';
      pwdInput.focus();
    }
  }

  btn.addEventListener('click', tryUnlock);
  pwdInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') tryUnlock();
  });
</script>

<style>
  .password-gate {
    padding: 2rem;
    text-align: center;
    background: var(--card-bg);
    border-radius: 0.75rem;
  }
  .password-gate input {
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
  }
  .password-gate button {
    padding: 0.5rem 1.5rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
  }
</style>
